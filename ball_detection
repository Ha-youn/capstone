import cv2
import numpy as np
import math

# --- 설정 ---
ROBOT_HEIGHT, TILT_ANGLE, FOCAL_LENGTH = 25.0, 20.0, 650.0
OFFSET_X, OFFSET_Y = 0.0, 0.0

# 현재 진행 방향 ("LEFT_TO_RIGHT" 또는 "RIGHT_TO_LEFT")
current_direction = "LEFT_TO_RIGHT"

def get_quadrant_score(f_x, f_y, direction):
    # 가깝고 먼 것을 나누는 기준 거리 (cm)
    f_y_mid = 60.0  
    
    is_left = f_x < 0
    is_near = f_y <= f_y_mid

    if direction == "LEFT_TO_RIGHT":
        if is_left and is_near: return 4
        if not is_left and is_near: return 3
        if is_left and not is_near: return 2
        return 1
    else:
        if not is_left and is_near: return 4
        if is_left and is_near: return 3
        if not is_left and not is_near: return 2
        return 1

def detect_and_track():
    global current_direction
    cap = cv2.VideoCapture(0)

    while True:
        ret, frame = cap.read()
        if not ret: break
        
        img_h, img_w = frame.shape[:2]
        center_x, center_y = img_w / 2, img_h / 2

        # 전처리
        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        mask = cv2.inRange(hsv, np.array([5, 150, 150]), np.array([35, 255, 255]))
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((5,5), np.uint8))
        
        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        ball_candidates = []

        for contour in contours:
            if cv2.contourArea(contour) > 100:
                (x, y), radius = cv2.minEnclosingCircle(contour)
                if radius > 10:
                    cX, cY = int(x), int(y)
                    dy = (cY + radius) - center_y
                    total_pitch_rad = math.radians(TILT_ANGLE) + math.atan2(dy, FOCAL_LENGTH)
                    
                    if total_pitch_rad > 0.05:
                        f_y = ROBOT_HEIGHT / math.tan(total_pitch_rad)
                        f_x = f_y * math.tan(math.atan2(cX - center_x, FOCAL_LENGTH))
                        
                        q_score = get_quadrant_score(f_x, f_y, current_direction)
                        total_score = (q_score * 1000) - f_y 
                        ball_candidates.append({
                            'cX': cX, 'cY': cY, 'radius': int(radius),
                            'f_x': f_x, 'f_y': f_y, 'score': total_score
                        })

        target_ball = None
        if ball_candidates:
            target_ball = max(ball_candidates, key=lambda b: b['score'])

        # --- 시각화 ---
        # 1. 세로 중앙선
        cv2.line(frame, (int(center_x), 0), (int(center_x), img_h), (255, 255, 255), 1)

        # 2. 가로 기준선 (60cm 지점 계산하여 그리기)
        f_y_mid = 60.0
        try:
            # 거리(60cm)를 픽셀 y좌표로 변환하는 역계산
            # angle = atan(H/D), pixel_y = tan(angle - tilt) * focal
            target_total_pitch = math.atan(ROBOT_HEIGHT / f_y_mid)
            target_pixel_dy = math.tan(target_total_pitch - math.radians(TILT_ANGLE)) * FOCAL_LENGTH
            line_y = int(center_y + target_pixel_dy)
            
            if 0 < line_y < img_h:
                cv2.line(frame, (0, line_y), (img_w, line_y), (255, 255, 255), 2)
        except:
            pass

        # 3. 공 표시
        for ball in ball_candidates:
            is_target = target_ball and ball == target_ball
            color = (0, 0, 255) if is_target else (0, 255, 0)
            thickness = 3 if is_target else 1
            
            cv2.circle(frame, (ball['cX'], ball['cY']), ball['radius'], color, thickness)
            
            if is_target:
                cv2.putText(frame, "TARGET", (ball['cX']-30, ball['cY']-ball['radius']-10),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)

        # 상태 정보
        cv2.putText(frame, f"DIR: {current_direction}", (10, 30), 1, 1.5, (255,0,0), 2)
        cv2.imshow('Quadrant Priority', frame)

        key = cv2.waitKey(1) & 0xFF
        if key == ord('q'): break
        elif key == ord('d'): current_direction = "RIGHT_TO_LEFT" if current_direction == "LEFT_TO_RIGHT" else "LEFT_TO_RIGHT"

    cap.release()
    cv2.destroyAllWindows()

detect_and_track()
